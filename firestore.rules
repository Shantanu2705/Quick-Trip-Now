rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Admins bypass everything (handled by Firebase Admin SDK anyway),
    // but if an admin authenticates from the client, give them access.
    function isAdmin() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // 1. PUBLIC READ, ADMIN WRITE
    // Safe public collections for the frontend
    match /packages/{document=**} {
      allow read: if true;
      allow write: if false; // Only Admin SDK can write
    }
    match /destinations/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    match /transfer_packages/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    match /cab-routes/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    match /globalSettings/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    match /coupons/{document=**} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // 2. PRIVATE READ/WRITE (Users can only access their own data)
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      // Only write to your own user document
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /bookings/{bookingId} {
      // Users can only read their own bookings
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      // Users shouldn't write bookings directly from the client, they should use API routes (Admin SDK)
      // This prevents a user from tampering with `paidAmount` or `status` directly from the browser.
      allow write: if false; 
    }

    // 3. DEFAULT DENY ALL
    // Blocks everything else completely
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
